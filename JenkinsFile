pipeline {
    agent any

    environment {
        DEPLOY_HOST = '192.168.0.23'
        // Ensure you have created a "Username with password" credential in Jenkins with this ID
        SSH_CRED_ID = 'ec2-ssh-key' 
    }

    stages {
        stage('Build and Test') {
            steps {
                sh 'mvn clean package'
            }
        }

        stage('Deploy to Cloud') {
            steps {
                // Use usernamePassword credentials binding instead of sshagent
                withCredentials([usernamePassword(credentialsId: "${SSH_CRED_ID}", usernameVariable: 'SSH_USER', passwordVariable: 'SSH_PASS')]) {
                    sh '''
                    # 1. Ensure the directory exists and scan the host key to avoid interactive prompts
                    mkdir -p ~/.ssh
                    ssh-keyscan -H "$DEPLOY_HOST" >> ~/.ssh/known_hosts

                    # 2. Create the application directory on the remote server
                    sshpass -p "$SSH_PASS" ssh $SSH_USER@$DEPLOY_HOST 'mkdir -p ~/app'

                    # 3. Copy the jar file using scp
                    sshpass -p "$SSH_PASS" scp target/f1worker-1.0.jar $SSH_USER@$DEPLOY_HOST:app/

                    # 4. Start the application in the background
                    sshpass -p "$SSH_PASS" ssh $SSH_USER@$DEPLOY_HOST \
                      "nohup java -jar ~/app/f1worker-1.0.jar > ~/app/app.log 2>&1 < /dev/null &"
                    '''
                }
            }
        }
    }
}
